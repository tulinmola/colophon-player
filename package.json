{
  "name": "colophon-player",
  "version": "0.2.0",
  "description": "Colophon Player",
  "main": "./dist/colophon-player.js",
  "exports": {
    ".": "./dist/colophon-player.js",
    "./colophon-player.css": "./dist/colophon-player.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tulinmola/colophon-player.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host",
    "build": "vite build",
    "dist": "vite build --mode dist",
    "prepack": "npm run dist",
    "preversion": "node tools/sync_docs_version.js --check",
    "version": "node tools/sync_docs_version.js && git add docs",
    "preview": "vite preview",
    "prettier:check": "npx prettier . --check",
    "prettier:write": "npx prettier . --write",
    "lint": "eslint 'src/**/*.js' 'tools/**/*.js' 'eslint.config.js' --ignore-pattern 'src/js/vendor/**/*'",
    "roms:fetch": "node tools/fetch_roms.js",
    "emulator:build": "node tools/build_emulator.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "check": "npm run prettier:check && npm run lint && npm test"
  },
  "keywords": [
    "colophon",
    "amstrad",
    "cpc",
    "emulator",
    "web-component",
    "wasm"
  ],
  "author": "tulinmola",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
